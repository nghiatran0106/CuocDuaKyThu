{
  "name": "turbo-buddies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "test:worker": "node --test tests/service-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.7",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
